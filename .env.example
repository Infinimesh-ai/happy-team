# Happy Team Edition — 环境变量模板
#
# 用法：复制为 .env 后填值。.env 已被 .gitignore 忽略，绝不要提交。
#   cp .env.example .env
#
# deploy/README.md §1 提供了一段可直接粘贴的生成器，会用 openssl 生成下面这些随机值。
# 带 [必填] 的项没有默认值，compose 会在启动前直接报错退出。

# ─────────────────────────────────────────────────────────────
# [必填] 密钥与初始管理员
# ─────────────────────────────────────────────────────────────

# 服务端主密钥。生成：openssl rand -base64 48
#
# 警告：在 Team Edition 里这个值不只用于 token。它派生出的密钥加密着
# 成员的托管 NaCl 私钥和 SSH 凭据。丢失 => 这些密文永久不可恢复；
# 泄漏 => 必须轮换并重置它保护的所有秘密（见 deploy/README.md §10）。
# 生产环境放密管，不要和它保护的数据库备份存在一起。
HANDY_MASTER_SECRET=

# 首个 Team 管理员。仅在库中不存在任何 ADMIN 时播种一次；
# 该管理员首次登录会被强制改密码。
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

# 基础设施密码。生成：openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 公开 URL —— 两个变量，解析自不同的网络，最常见的配错点
# ─────────────────────────────────────────────────────────────

# 构建期烧进 webapp 的 API 地址，必须能被【浏览器】访问。
# 改这个值之后必须重新 build webapp 镜像才会生效。
HAPPY_PUBLIC_SERVER_URL=http://localhost:3005

# server 生成 enroll / manual / artifact URL 时使用，必须能被【目标机器】访问。
# 生产环境通常与上面相同；Docker 内网 E2E 时可能需要写成 http://server:3005。
# 预检会把 localhost 值标为 warning，就是为了提示这一点。
TEAM_PUBLIC_SERVER_URL=http://localhost:3005

# MinIO 对外地址；生产环境换成真实的 MinIO 或 CDN 域名。
S3_PUBLIC_URL=http://localhost:9000/happy-team

# ─────────────────────────────────────────────────────────────
# 公司 Agent API key（COMPANY_API 模式下注入成员机器）
# ─────────────────────────────────────────────────────────────
#
# 至少配一个，否则对应 agent 的 provisioning 会在 setup_agents 步骤失败，
# 报 "TEAM_ANTHROPIC_API_KEY is not configured"。

TEAM_ANTHROPIC_API_KEY=
TEAM_OPENAI_API_KEY=

# 可选：企业网关 / 代理，会被一并写入成员机器的 agent.env
# TEAM_ANTHROPIC_BASE_URL=
# TEAM_OPENAI_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 制品分发
# ─────────────────────────────────────────────────────────────

# 宿主机上存放非 Linux-x64 Node 二进制的目录，compose 会只读挂载进容器。
# 用 `pnpm team:node-artifacts` 生成。Linux x64 glibc 默认由 server 自身
# 的 process.execPath 分发，不需要放文件。
TEAM_NODE_ARTIFACT_HOST_DIR=./.team-artifacts/node

# 容器内的对应路径，一般不用改
# TEAM_NODE_ARTIFACT_DIR=/opt/happy-team/artifacts/node

# 覆盖 CLI tarball 路径，一般不用改（镜像构建时已内置）
# TEAM_CLI_ARTIFACT_PATH=/opt/happy-team/artifacts/happy-cli.tgz

# ─────────────────────────────────────────────────────────────
# 生产域名与 TLS（启用 caddy profile 时才需要）
#   docker compose --profile proxy up -d --build
# ─────────────────────────────────────────────────────────────

# HAPPY_WEB_HOST=happy.yourco.com
# HAPPY_API_HOST=api.happy.yourco.com

# ─────────────────────────────────────────────────────────────
# 可选覆盖项（有默认值，通常不用动）
# ─────────────────────────────────────────────────────────────

# POSTGRES_USER=happy
# POSTGRES_DB=happy
# MINIO_ROOT_USER=happyminio
# MINIO_BUCKET=happy-team
# HAPPY_WEB_PORT=8080
# HAPPY_SERVER_PORT=3005
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
# METRICS_ENABLED=false
